# ─────────────────────────────────────────────────────────────────────────────
# ARGOS SLOPE 4.0 — Variables de Entorno
# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo como .env y ajusta los valores según tu entorno.
#   cp .env.example .env          # Linux / macOS
#   copy .env.example .env        # Windows

# ─── Backend (FastAPI) ────────────────────────────────────────────────────
# URL de conexión a PostgreSQL con asyncpg.
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mineriadb

# ─── Frontend (Next.js) ───────────────────────────────────────────────────
# URL base del backend (sin /api — el cliente agrega las rutas automáticamente).
# NEXT_PUBLIC_* se expone al navegador, no uses secretos aquí.
NEXT_PUBLIC_API_URL=http://localhost:8000
