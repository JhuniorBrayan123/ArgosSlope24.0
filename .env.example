# ─────────────────────────────────────────────────────────────────────────────
# ARGOS SLOPE 4.0 — Variables de Entorno
# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo como .env y ajusta los valores según tu entorno.
#   cp .env.example .env          # Linux / macOS
#   copy .env.example .env        # Windows

# ─── Backend (FastAPI — existente) ────────────────────────────────────────
# URL de conexión a PostgreSQL con asyncpg.
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=postgresql+asyncpg://postgres:Jhunior@localhost:5432/mineriadb

# ─── Backend (.NET — nuevo) ───────────────────────────────────────────────
# Formato: Host=host;Database=mineriadb;Username=user;Password=pass
DATABASE_URL_DOTNET=Host=localhost;Database=mineriadb;Username=postgres;Password=postgres

# ─── MQTT Broker ─────────────────────────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── Edge Device ─────────────────────────────────────────────────────────
CAMERA_SOURCE=0
DETECTOR_METHOD=opencv
MQTT_TOPIC_PREFIX=argos/slope-01
FRAME_WIDTH=640
FRAME_HEIGHT=480
FPS=10
DEBUG_SAVE_FRAMES=false

# ─── Frontend (Next.js) ───────────────────────────────────────────────────
# URL base del backend (sin /api — el cliente agrega las rutas automáticamente).
# NEXT_PUBLIC_* se expone al navegador, no uses secretos aquí.
NEXT_PUBLIC_API_URL=http://localhost:8000